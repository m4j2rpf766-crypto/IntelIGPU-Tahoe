#!/bin/sh
set -eu
if [ "$#" -ne 0 ]; then
    echo "igpu-start takes no arguments; it detects cold, prepared, published, and video-only recovery states." >&2
    exit 64
fi
if [ "$(id -u)" -ne 0 ]; then
    echo "Run the single startup command as administrator:" >&2
    echo "sudo ./igpu-start" >&2
    exit 77
fi
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec /usr/bin/python3 "$repo_root/desktop-manual-20260917/fix/session.py"
